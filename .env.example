# --- Local development: no configuration needed (uses ./local.db and demo accounts) ---

# --- Production (Vercel) ---
# Free Turso database (https://turso.tech): `turso db create restodemo`, `turso db show restodemo --url`,
# `turso db tokens create restodemo`
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Staff accounts created on first run (nothing is created in production if these are missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
MESERO_EMAIL=
MESERO_PASSWORD=
